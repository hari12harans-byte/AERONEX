# Copy to .env (project root or backend/.env). Never commit .env. Real environment variables override this file.

# Application
# The backend listens on the port in API_BASE_URL unless PORT is set. The Vite dev server proxies /api to it.
API_BASE_URL=http://localhost:8000
# Browser origins allowed to call the API from another origin
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=0
REFRESH_SECONDS=60
# Not used by the code yet (no demo account is seeded)
SEED_DEMO_ACCOUNT=0
# Production only: AUTH_SECRET=<64 random hex chars>, NODE_ENV=production, COOKIE_SECURE=1, TRUST_PROXY=1, VITE_SITE_URL=https://your-domain

# Supabase (reserved: not wired into the backend yet)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (reserved: sign-in not built yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# n8n (reserved: events not built yet)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# WhatsApp (reserved, disabled)
WHATSAPP_ENABLED=0
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Airplanes.live (live aircraft)
AIRPLANES_LIVE_ENABLED=1
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live
AIRPLANES_LIVE_LAT=13.0827
AIRPLANES_LIVE_LON=80.2707
AIRPLANES_LIVE_RADIUS_NM=50

# OpenFlights (reserved: the app ships a built-in list of 9 airports)
OPENFLIGHTS_ENABLED=1

# Weather
OPEN_METEO_ENABLED=1

# AviationStack (backend only; keep secret)
AVIATIONSTACK_API_KEY=

# Optional local AeroNex ML service (see ml/SETUP.md). Without it AeroNex uses the rule-based Connection Guardian only.
ML_API_URL=http://127.0.0.1:5000
ML_TIMEOUT_MS=2500
